# General configuration
COMPOSE_PROJECT_NAME=hello_docker_web

# Container configuration
CONTAINER_NAME=my-apache-app
HOST_PORT=8080
CONTAINER_PORT=80

# Path configuration
# This is where your website files are located locally
APP_PATH=/app

# Database configuration
DB_ROOT_PASSWORD=root_password 
DB_NAME=my_database
DB_USER=my_user
DB_PASSWORD=my_password

DB_HOST_PORT=3306
DB_CONTAINER_PORT=3306
DB_HOST=db

# PhpMyAdmin configuration
PMA_HOST_PORT=8081

# Image configuration
IMAGE_NAME=my-apache-app
IMAGE_TAG=latest